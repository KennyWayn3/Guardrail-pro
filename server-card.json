        "required": [
          "content",
          "framework"
        ]
      }
    },
    {
      "name": "detect_pii",
      "description": "Detects PII in text. Free tier: 5 calls per day.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Content to analyze for PII"
          }
        },
        "required": [
          "content"
        ]
      }
    }
  ],
